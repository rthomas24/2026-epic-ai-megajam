+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FTDDirectorDisplayActualHost,"TriadDrift.UI.Director.ActualHostReflectionContract",TDDirectorDisplayTests::Flags)
+bool FTDDirectorDisplayActualHost::RunTest(const FString&)
+{
+    UClass* Host=FindObject<UClass>(nullptr,TEXT("/Script/unrealGameJam.TDDirectorSubsystem"));
+    if(!TestNotNull(TEXT("actual game host must be loaded for this separate integration contract test"),Host))return false;
+    UFunction* Getter=Host->FindFunctionByName(TEXT("GetDirectorCardsFor"));
+    const auto* Return=Getter?CastField<FStructProperty>(Getter->GetReturnProperty()):nullptr;
+    const auto* Claim=Return?FindFProperty<FBoolProperty>(Return->Struct,TEXT("bNameCardClaimedByHUD")):nullptr;
+    if(!TestNotNull(TEXT("matching T3 host MUST expose the new typed ownership field; older hosts are incompatible"),Claim))return false;
+    TestEqual(TEXT("claim must be one bool, not an array"),Claim->ArrayDim,1);
+    if(!TestTrue(TEXT("actual native host getter has exact supported reflected signature"),UTDDirectorCardsWidget::IsSupportedGetter(Getter)))return false;
+    FTDDirectorCardsDisplay Frame;
+    {
+        FStructOnScope Parameters(Getter);
+        // Initialized null world context: owner's real getter must return empty safely, with no gameplay state changes.
+        Host->GetDefaultObject()->ProcessEvent(Getter,Parameters.GetStructMemory());
+        const auto* Ret=CastFieldChecked<FStructProperty>(Getter->GetReturnProperty());
+        TestTrue(TEXT("actual engineering return struct maps, without C++ include/cast"),UTDDirectorCardsWidget::DecodeCards(Ret->Struct,Ret->ContainerPtrToValuePtr<void>(Parameters.GetStructMemory()),Frame));
+    }
+    TestTrue(TEXT("null-world actual host returns empty, no fabricated state"),Frame.IsEmpty());
+    return true;
+}
