+/** The only live read is at paint: no delegate signature cast, tick, second clock, animation or retained snapshot. */
+class SCards final : public SLeafWidget
+{
+public:
+    SLATE_BEGIN_ARGS(SCards) {} SLATE_ARGUMENT(TWeakObjectPtr<UTDDirectorCardsWidget>,Owner) SLATE_END_ARGS()
+    void Construct(const FArguments& Args){Owner=Args._Owner;SetVisibility(EVisibility::HitTestInvisible);ForceVolatile(true);}
+    virtual FVector2D ComputeDesiredSize(float) const override{return FVector2D::ZeroVector;}
+    virtual int32 OnPaint(const FPaintArgs&,const FGeometry& G,const FSlateRect&,FSlateWindowElementList& List,int32 Layer,const FWidgetStyle& Style,bool) const override
+    {
+        const UTDDirectorCardsWidget* W=Owner.Get();
+        FTDDirectorCardsDisplay Frame;
+        if(!W || !W->ReadFreshCards(Frame) || Frame.IsEmpty())return Layer;
+        const FVector2D Size=G.GetLocalSize();
+        const FTDDirectorCardsLayout L=UTDDirectorCardsWidget::LayoutFor(Size,Frame.Letterbox);
+        if(!L.bValid)return Layer;
+        const FLinearColor Tint=Style.GetColorAndOpacityTint();
+        const FSlateBrush* White=FCoreStyle::Get().GetBrush(TEXT("WhiteBrush"));
+        auto Box=[&](const FBox2D& R,FLinearColor Color,int32 Z=0)
+        {
+            if(R.GetSize().X<=0 || R.GetSize().Y<=0)return;
+            FSlateDrawElement::MakeBox(List,Layer+Z,G.ToPaintGeometry(R.GetSize(),FSlateLayoutTransform(R.Min)),White,ESlateDrawEffect::None,Color*Tint);
+        };
+        auto Edge=[&](const FBox2D& R,FLinearColor Color,float Width=1.f)
+        {
+            const float C=10*L.Scale;
+            TArray<FVector2D> P={{R.Min.X+C,R.Min.Y},{R.Max.X-C,R.Min.Y},{R.Max.X,R.Min.Y+C},
+                {R.Max.X,R.Max.Y-C},{R.Max.X-C,R.Max.Y},{R.Min.X+C,R.Max.Y},{R.Min.X,R.Max.Y-C},{R.Min.X,R.Min.Y+C},{R.Min.X+C,R.Min.Y}};
+            FSlateDrawElement::MakeLines(List,Layer+2,G.ToPaintGeometry(),P,ESlateDrawEffect::None,Color*Tint,true,Width*L.Scale);
+        };
+        auto Label=[&](const FText& Text,const FBox2D& R,int32 Preferred,FLinearColor Color,bool Bold,bool Center,int32 MaxLines)
+        {
+            if(Text.IsEmpty())return;
+            const auto Fit=UTDDirectorCardsWidget::FitText(Text,R.GetSize(),FMath::Max(1,FMath::RoundToInt(Preferred*L.Scale)),Bold,MaxLines);
+            if(Fit.Lines.IsEmpty())return;
+            const FSlateFontInfo Font=FCoreStyle::GetDefaultFontStyle(Bold?TEXT("Bold"):TEXT("Regular"),Fit.FontSize);
+            List.PushClip(FSlateClippingZone(G.ToPaintGeometry(R.GetSize(),FSlateLayoutTransform(R.Min))));
+            float Y=R.Min.Y+(R.GetSize().Y-Fit.Measured.Y)*.5f;
+            for(const FString& Line:Fit.Lines)
+            {
+                const FVector2D M=Measure(Line,Fit.FontSize,Bold);
+                const FVector2D At(Center?R.GetCenter().X-M.X*.5f:R.Min.X,Y);
+                FSlateDrawElement::MakeText(List,Layer+3,G.ToPaintGeometry(M,FSlateLayoutTransform(At+FVector2D(1,2)*L.Scale)),Line,Font,ESlateDrawEffect::None,FLinearColor(0,0,0,Color.A*.85f)*Tint);
+                FSlateDrawElement::MakeText(List,Layer+4,G.ToPaintGeometry(M,FSlateLayoutTransform(At)),Line,Font,ESlateDrawEffect::None,Color*Tint);
+                Y+=Fit.LineHeight;
+            }
+            List.PopClip();
+        };
+        auto Panel=[&](const FBox2D& R,const FTDDirectorCardDisplay& Card)
+        {
+            Box(R,FLinearColor(.008f,.018f,.028f,.88f*Card.Alpha),1);
+            Edge(R,Card.Color.CopyWithNewOpacity(Card.Alpha*.66f));
+            const float D=5*L.Scale;
+            Box(FBox2D(R.Min+FVector2D(0,10)*L.Scale,FVector2D(R.Min.X+D,R.Max.Y-10*L.Scale)),Card.Color.CopyWithNewOpacity(Card.Alpha),2);
+            Box(FBox2D(R.Min+FVector2D(18,8)*L.Scale,FVector2D(R.Max.X-18*L.Scale,R.Min.Y+9*L.Scale)),FLinearColor(.7f,.8f,.85f,Card.Alpha*.20f),2);
+        };
+        const FLinearColor Ink(.90f,.95f,.98f);
+        Box(L.TopBar,FLinearColor::Black);Box(L.BottomBar,FLinearColor::Black);
+        if(Frame.Slate.bActive && Frame.Slate.Alpha>0 && (!Frame.Slate.Text.IsEmpty() || !Frame.Slate.SubText.IsEmpty()))
+        {
+            Panel(L.Slate,Frame.Slate);
+            const FBox2D Text(L.Slate.Min+FVector2D(28,16)*L.Scale,L.Slate.Max-FVector2D(28,16)*L.Scale);
+            const bool Sub=!Frame.Slate.SubText.IsEmpty();
+            Label(Frame.Slate.Text,Sub?FBox2D(Text.Min,FVector2D(Text.Max.X,Text.Min.Y+42*L.Scale)):Text,30,Ink.CopyWithNewOpacity(Frame.Slate.Alpha),true,true,Sub?1:2);
+            if(Sub)Label(Frame.Slate.SubText,FBox2D(Text.Min+FVector2D(0,46)*L.Scale,Text.Max),18,Frame.Slate.Color.CopyWithNewOpacity(Frame.Slate.Alpha),false,true,1);
+        }
+        if(UTDDirectorCardsWidget::ShouldDrawPilotText(Frame) && Frame.NameCard.bActive && Frame.NameCard.Alpha>0 && (!Frame.NameCard.Text.IsEmpty() || !Frame.NameCard.SubText.IsEmpty()))
+        {
+            Panel(L.Pilot,Frame.NameCard);
+            Label(Frame.NameCard.Text,FBox2D(L.Pilot.Min+FVector2D(26,15)*L.Scale,L.Pilot.Max-FVector2D(26,73)*L.Scale),38,Ink.CopyWithNewOpacity(Frame.NameCard.Alpha),true,false,1);
+            Label(Frame.NameCard.SubText,FBox2D(L.Pilot.Min+FVector2D(26,79)*L.Scale,L.Pilot.Max-FVector2D(26,16)*L.Scale),20,Frame.NameCard.Color.CopyWithNewOpacity(Frame.NameCard.Alpha),false,false,2);
+        }
+        // Switch state is an edge mark, not a duplicate pilot card; quick cuts never add their own bars or clock.
+        if(Frame.SwitchCut.bActive && Frame.SwitchCut.Alpha>0)
+        {
+            if(!UTDDirectorCardsWidget::ShouldDrawPilotText(Frame))
+            {
+                // A small non-textual switch cue survives even when the HUD owns all pilot-name text.
+                Box(FBox2D(L.Pilot.Min+FVector2D(0,28)*L.Scale,L.Pilot.Min+FVector2D(4,92)*L.Scale),Frame.SwitchCut.Color.CopyWithNewOpacity(Frame.SwitchCut.Alpha),2);
+            }
+            else if(Frame.NameCard.bActive)Edge(L.Pilot,Frame.SwitchCut.Color.CopyWithNewOpacity(Frame.SwitchCut.Alpha),2.f);
+            else if(!Frame.SwitchCut.Text.IsEmpty())
+            {
+                Panel(L.Pilot,Frame.SwitchCut);
+                Label(Frame.SwitchCut.Text,FBox2D(L.Pilot.Min+FVector2D(26,18)*L.Scale,L.Pilot.Max-FVector2D(26,18)*L.Scale),36,Ink.CopyWithNewOpacity(Frame.SwitchCut.Alpha),true,false,2);
+            }
+        }
+        if(Frame.MoneyShot.bActive && Frame.MoneyShot.Alpha>0)
+        {
+            Label(Frame.MoneyShot.Text.IsEmpty()?Frame.MoneyShot.SubText:Frame.MoneyShot.Text,L.Shot,18,Frame.MoneyShot.Color.CopyWithNewOpacity(Frame.MoneyShot.Alpha),false,true,1);
+        }
+        if(Frame.Cut.bActive && Frame.Cut.Alpha>0 && !Frame.Cut.Text.IsEmpty())
+        {
+            Panel(L.Cut,Frame.Cut);
+            const bool Sub=!Frame.Cut.SubText.IsEmpty();
+            Label(Frame.Cut.Text,FBox2D(L.Cut.Min+FVector2D(32,20)*L.Scale,L.Cut.Max-FVector2D(32,Sub?70:20)*L.Scale),104,Ink.CopyWithNewOpacity(Frame.Cut.Alpha),true,true,1);
+            if(Sub)Label(Frame.Cut.SubText,FBox2D(L.Cut.Min+FVector2D(32,150)*L.Scale,L.Cut.Max-FVector2D(32,16)*L.Scale),22,Frame.Cut.Color.CopyWithNewOpacity(Frame.Cut.Alpha),false,true,2);
+        }
+        if(Frame.FlashAlpha>0)Box(FBox2D(FVector2D::ZeroVector,Size),FLinearColor(1,1,1,Frame.FlashAlpha),5);
+        return Layer+5;
+    }
+private:
+    TWeakObjectPtr<UTDDirectorCardsWidget> Owner;
+};
+}
