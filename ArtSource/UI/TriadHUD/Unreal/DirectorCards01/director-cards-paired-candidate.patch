+bool FTDDirectorCardsDisplay::IsEmpty() const
+{
+    return Letterbox<=0 && FlashAlpha<=0 &&
+        !(SwitchCut.bActive && SwitchCut.Alpha>0) && !(NameCard.bActive && NameCard.Alpha>0) &&
+        !(Slate.bActive && Slate.Alpha>0) && !(Cut.bActive && Cut.Alpha>0) && !(MoneyShot.bActive && MoneyShot.Alpha>0);
