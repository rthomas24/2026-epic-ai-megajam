+TSharedRef<SWidget> UTDDirectorCardsWidget::RebuildWidget()
+{
+    SetIsFocusable(false);
+    SetVisibility(ESlateVisibility::HitTestInvisible);
+    return SNew(TDDirectorDisplay::SCards).Owner(TWeakObjectPtr<UTDDirectorCardsWidget>(this));
+}
+void UTDDirectorCardsWidget::ReleaseSlateResources(bool bReleaseChildren)
+{
+    Super::ReleaseSlateResources(bReleaseChildren); // no delegate, timer, retained model or external ownership to release
+}
