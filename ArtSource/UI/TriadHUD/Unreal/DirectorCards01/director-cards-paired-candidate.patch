+template<class T> const T* Field(const UStruct* Type,const TCHAR* Name)
+{
+    const T* P=Type?FindFProperty<T>(Type,Name):nullptr;
+    return P && P->ArrayDim==1?P:nullptr;
+}
+bool CardShape(const UScriptStruct* Type)
+{
+    const FStructProperty* Color=Field<FStructProperty>(Type,TEXT("Color"));
+    return Field<FBoolProperty>(Type,TEXT("bActive")) && Field<FTextProperty>(Type,TEXT("Text")) &&
+        Field<FTextProperty>(Type,TEXT("SubText")) && Color && Color->Struct==TBaseStructure<FLinearColor>::Get() &&
+        Field<FFloatProperty>(Type,TEXT("Alpha")) && Field<FFloatProperty>(Type,TEXT("Progress01")) &&
+        Field<FFloatProperty>(Type,TEXT("TimeLeft"));
+}
+bool FrameShape(const UScriptStruct* Type,bool bHostNames=false)
+{
+    if(!Type || (bHostNames && Type->GetFName()!=TEXT("TDDirectorCards"))) return false;
+    for(const TCHAR* Name:{TEXT("SwitchCut"),TEXT("NameCard"),TEXT("Slate"),TEXT("Cut"),TEXT("MoneyShot")})
+    {
+        const FStructProperty* P=Field<FStructProperty>(Type,Name);
+        if(!P || !CardShape(P->Struct) || (bHostNames && P->Struct->GetFName()!=TEXT("TDDirectorCard"))) return false;
+    }
+    return Field<FBoolProperty>(Type,TEXT("bQuickCut")) && Field<FBoolProperty>(Type,TEXT("bNameCardClaimedByHUD")) && Field<FIntProperty>(Type,TEXT("SwitchCount")) &&
+        Field<FNameProperty>(Type,TEXT("SlateScene")) && Field<FIntProperty>(Type,TEXT("SlateTake")) &&
+        Field<FFloatProperty>(Type,TEXT("Letterbox")) && Field<FFloatProperty>(Type,TEXT("FlashAlpha"));
+}
+bool Card(const UScriptStruct* Type,const void* Memory,FTDDirectorCardDisplay& Out)
+{
+    Out.bActive=Field<FBoolProperty>(Type,TEXT("bActive"))->GetPropertyValue_InContainer(Memory);
+    Out.Text=Field<FTextProperty>(Type,TEXT("Text"))->GetPropertyValue_InContainer(Memory);
+    Out.SubText=Field<FTextProperty>(Type,TEXT("SubText"))->GetPropertyValue_InContainer(Memory);
+    Out.Color=*Field<FStructProperty>(Type,TEXT("Color"))->ContainerPtrToValuePtr<FLinearColor>(Memory);
+    Out.Alpha=Field<FFloatProperty>(Type,TEXT("Alpha"))->GetPropertyValue_InContainer(Memory);
+    Out.Progress01=Field<FFloatProperty>(Type,TEXT("Progress01"))->GetPropertyValue_InContainer(Memory);
+    Out.TimeLeft=Field<FFloatProperty>(Type,TEXT("TimeLeft"))->GetPropertyValue_InContainer(Memory);
+    if(!FMath::IsFinite(Out.Alpha) || !FMath::IsFinite(Out.Progress01) || !FMath::IsFinite(Out.TimeLeft) ||
+       !FMath::IsFinite(Out.Color.R) || !FMath::IsFinite(Out.Color.G) || !FMath::IsFinite(Out.Color.B) || !FMath::IsFinite(Out.Color.A)) return false;
+    Out.Alpha=FMath::Clamp(Out.Alpha,0.f,1.f);
+    Out.Progress01=FMath::Clamp(Out.Progress01,0.f,1.f);
+    Out.TimeLeft=FMath::Max(0.f,Out.TimeLeft);
+    return true;
+}
+FVector2D Measure(const FString& Text,int32 Size,bool Bold)
+{
+    const FSlateFontInfo Font=FCoreStyle::GetDefaultFontStyle(Bold?TEXT("Bold"):TEXT("Regular"),Size);
+    if(FSlateApplication::IsInitialized() && FSlateApplication::Get().GetRenderer())
+        return FSlateApplication::Get().GetRenderer()->GetFontMeasureService()->Measure(Text,Font);
+    return FVector2D(Text.Len()*Size*.64f,Size*1.35f);
+}
+TArray<FString> Wrap(const FString& Text,float Width,int32 Size,bool Bold)
+{
+    TArray<FString> Paragraphs,Lines;
+    Text.ParseIntoArrayLines(Paragraphs,false);
+    for(FString Remaining:Paragraphs)
+    {
+        if(Remaining.IsEmpty()){Lines.Add(FString());continue;}
+        while(!Remaining.IsEmpty())
+        {
+            if(Measure(Remaining,Size,Bold).X<=Width){Lines.Add(Remaining);break;}
+            int32 Low=1,High=Remaining.Len();
+            while(Low<High){const int32 Mid=(Low+High+1)/2;if(Measure(Remaining.Left(Mid),Size,Bold).X<=Width)Low=Mid;else High=Mid-1;}
+            int32 Break=Low;
+            for(int32 I=Low-1;I>0;--I){if(FChar::IsWhitespace(Remaining[I])){Break=I;break;}}
+            Lines.Add(Remaining.Left(Break));
+            Remaining=Remaining.Mid(Break);
+            if(!Remaining.IsEmpty() && FChar::IsWhitespace(Remaining[0]))Remaining.RightChopInline(1);
+        }
+    }
+    return Lines;
+}
