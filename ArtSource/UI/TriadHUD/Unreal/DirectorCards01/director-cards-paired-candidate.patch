+bool UTDDirectorCardsWidget::ShouldDrawPilotText(const FTDDirectorCardsDisplay& Frame)
+{
+    return !Frame.bNameCardClaimedByHUD;
+}
+
+FTDDirectorCardsLayout UTDDirectorCardsWidget::LayoutFor(const FVector2D& Size,float Letterbox)
+{
+    FTDDirectorCardsLayout L;
+    if(!FMath::IsFinite(Size.X) || !FMath::IsFinite(Size.Y) || Size.X<=0 || Size.Y<=0 || !FMath::IsFinite(Letterbox))return L;
+    L.Scale=FMath::Min(Size.X/1920.f,Size.Y/1080.f);
+    const FVector2D Offset=(Size-FVector2D(1920,1080)*L.Scale)*.5f;
+    auto Rect=[&](float X,float Y,float W,float H){return FBox2D(Offset+FVector2D(X,Y)*L.Scale,Offset+FVector2D(X+W,Y+H)*L.Scale);};
+    const float Bar=Size.Y*FMath::Clamp(Letterbox,0.f,.5f);
+    L.TopBar=FBox2D(FVector2D::ZeroVector,FVector2D(Size.X,Bar));
+    L.BottomBar=FBox2D(FVector2D(0,Size.Y-Bar),Size);
+    L.Pilot=Rect(112,430,600,158);
+    L.Slate=Rect(400,FMath::Max(225.f,Bar/L.Scale+24.f),1120,112);
+    L.Cut=Rect(550,410,820,220);
+    L.Shot=Rect(660,30,600,44);
+    L.bValid=true;
+    return L;
+}
+
+FTDDirectorCardTextLayout UTDDirectorCardsWidget::FitText(const FText& Text,const FVector2D& Space,int32 Preferred,bool Bold,int32 MaxLines)
+{
+    using namespace TDDirectorDisplay;
+    FTDDirectorCardTextLayout Result;
+    if(Text.IsEmpty() || Space.X<=0 || Space.Y<=0 || !FMath::IsFinite(Space.X) || !FMath::IsFinite(Space.Y) || MaxLines<=0)return Result;
+    const FString Source=Text.ToString();
+    for(int32 Font=FMath::Clamp(Preferred,1,256);Font>=1;--Font)
+    {
+        auto Lines=Wrap(Source,Space.X,Font,Bold);
+        const float Height=FMath::Max(Measure(TEXT("Ag"),Font,Bold).Y,Font*1.25f);
+        if(Lines.Num()>MaxLines || Height*Lines.Num()>Space.Y)continue;
+        Result.FontSize=Font;Result.LineHeight=Height;Result.Lines=MoveTemp(Lines);
+        for(const FString& Line:Result.Lines)Result.Measured.X=FMath::Max(Result.Measured.X,Measure(Line,Font,Bold).X);
+        Result.Measured.Y=Height*Result.Lines.Num();
+        return Result;
+    }
+    return Result; // pathological unrenderable input fails blank rather than drawing outside its panel
+}
