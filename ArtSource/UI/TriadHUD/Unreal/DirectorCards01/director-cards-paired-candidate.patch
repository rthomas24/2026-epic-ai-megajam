+bool UTDDirectorCardsWidget::DecodeCards(const UScriptStruct* Type,const void* Data,FTDDirectorCardsDisplay& Out)
+{
+    using namespace TDDirectorDisplay;
+    Out=FTDDirectorCardsDisplay();
+    if(!Data || !FrameShape(Type))return false;
+    FTDDirectorCardsDisplay Next;
+    const TCHAR* Names[]={TEXT("SwitchCut"),TEXT("NameCard"),TEXT("Slate"),TEXT("Cut"),TEXT("MoneyShot")};
+    FTDDirectorCardDisplay* Cards[]={&Next.SwitchCut,&Next.NameCard,&Next.Slate,&Next.Cut,&Next.MoneyShot};
+    for(int32 I=0;I<5;++I)
+    {
+        const FStructProperty* P=Field<FStructProperty>(Type,Names[I]);
+        if(!Card(P->Struct,P->ContainerPtrToValuePtr<void>(Data),*Cards[I]))return false;
+    }
+    Next.bQuickCut=Field<FBoolProperty>(Type,TEXT("bQuickCut"))->GetPropertyValue_InContainer(Data);
+    Next.bNameCardClaimedByHUD=Field<FBoolProperty>(Type,TEXT("bNameCardClaimedByHUD"))->GetPropertyValue_InContainer(Data);
+    Next.SwitchCount=Field<FIntProperty>(Type,TEXT("SwitchCount"))->GetPropertyValue_InContainer(Data);
+    Next.SlateScene=Field<FNameProperty>(Type,TEXT("SlateScene"))->GetPropertyValue_InContainer(Data);
+    Next.SlateTake=Field<FIntProperty>(Type,TEXT("SlateTake"))->GetPropertyValue_InContainer(Data);
+    Next.Letterbox=Field<FFloatProperty>(Type,TEXT("Letterbox"))->GetPropertyValue_InContainer(Data);
+    Next.FlashAlpha=Field<FFloatProperty>(Type,TEXT("FlashAlpha"))->GetPropertyValue_InContainer(Data);
+    if(!FMath::IsFinite(Next.Letterbox) || !FMath::IsFinite(Next.FlashAlpha))return false;
+    Next.Letterbox=FMath::Clamp(Next.Letterbox,0.f,.5f);
+    Next.FlashAlpha=FMath::Clamp(Next.FlashAlpha,0.f,1.f);
+    Out=MoveTemp(Next);
+    return true;
+}
+
+bool UTDDirectorCardsWidget::IsSupportedGetter(const UFunction* Function)
+{
+    using namespace TDDirectorDisplay;
+    if(!Function || !Function->HasAllFunctionFlags(FUNC_Static|FUNC_Native|FUNC_BlueprintPure) || Function->NumParms!=2)return false;
+    const FStructProperty* Ret=CastField<FStructProperty>(Function->GetReturnProperty());
+    const FObjectPropertyBase* Context=FindFProperty<FObjectPropertyBase>(Function,TEXT("WorldContextObject"));
+    if(!Ret || Ret->ArrayDim!=1 || !FrameShape(Ret->Struct,true) || !Context || Context->ArrayDim!=1 ||
+       Context->PropertyClass!=UObject::StaticClass() || !Context->HasAnyPropertyFlags(CPF_Parm) ||
+       Context->HasAnyPropertyFlags(CPF_OutParm|CPF_ReturnParm))return false;
+    for(TFieldIterator<FProperty> It(Function);It;++It)
+    {
+        const FProperty* P=*It;
+        if(P->HasAnyPropertyFlags(CPF_Parm) && (P!=Ret && P!=Context))return false;
+        if(P->HasAnyPropertyFlags(CPF_Parm) && (P->GetOffset_ForUFunction()<0 || P->GetOffset_ForUFunction()+P->GetSize()>Function->ParmsSize))return false;
+    }
+    return true;
+}
+
+bool UTDDirectorCardsWidget::ReadFreshCards(FTDDirectorCardsDisplay& Out) const
+{
+    Out=FTDDirectorCardsDisplay();
+    const APlayerController* PC=GetOwningPlayer();
+    UWorld* World=GetWorld();
+    if(!IsValid(PC) || !GetOwningLocalPlayer() || !PC->IsLocalController() || !IsValid(World) || World->bIsTearingDown || !World->IsGameWorld() || PC->GetWorld()!=World)return false;
+    UClass* Host=FindObject<UClass>(nullptr,TEXT("/Script/unrealGameJam.TDDirectorSubsystem"));
+    UFunction* Getter=Host?Host->FindFunctionByName(TEXT("GetDirectorCardsFor")):nullptr;
+    if(!IsSupportedGetter(Getter))
+    {
+        if(!bReportedIncompatibleHost)
+        {
+            UE_LOG(LogTDDirectorCards,Warning,TEXT("Director renderer requires typed FTDDirectorCards.bNameCardClaimedByHUD and the current native GetDirectorCardsFor signature; incompatible host renders blank, no ownership policy inferred."));
+            bReportedIncompatibleHost=true;
+        }
+        return false;
+    }
+    bReportedIncompatibleHost=false;
+    // UFunction owns its actual parameter layout. All FText/struct storage is initialized and destroyed by reflection.
+    FStructOnScope Parameters(Getter);
+    const FObjectPropertyBase* Context=FindFProperty<FObjectPropertyBase>(Getter,TEXT("WorldContextObject"));
+    Context->SetObjectPropertyValue_InContainer(Parameters.GetStructMemory(),const_cast<UTDDirectorCardsWidget*>(this));
+    Host->GetDefaultObject()->ProcessEvent(Getter,Parameters.GetStructMemory());
+    const FStructProperty* Ret=CastField<FStructProperty>(Getter->GetReturnProperty());
+    return DecodeCards(Ret->Struct,Ret->ContainerPtrToValuePtr<void>(Parameters.GetStructMemory()),Out);
+}
+
+bool UTDDirectorCardsWidget::HasCompatibleHostContract() const
+{
+    UClass* Host=FindObject<UClass>(nullptr,TEXT("/Script/unrealGameJam.TDDirectorSubsystem"));
+    return IsSupportedGetter(Host?Host->FindFunctionByName(TEXT("GetDirectorCardsFor")):nullptr);
+}
