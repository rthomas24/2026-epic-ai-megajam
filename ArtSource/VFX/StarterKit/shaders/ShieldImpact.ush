float elapsed = max(Clock-StartTime,0.0);
float age = saturate(elapsed/max(Lifetime,0.01));
if (PreviewLoop > 0.5) age = frac(Clock/max(Lifetime*2.5,0.025));
float2 p = (UV-0.5)/max(Width,0.05);
float r = length(p);
float wave = exp(-pow((r-age*0.75)/0.025,2.0));
float inner = exp(-pow((r-age*0.5)/0.018,2.0))*0.35;
float hex = pow(abs(sin(p.x*35.0)*sin((p.x*0.5+p.y*0.866)*35.0)),16.0);
float lattice = hex*exp(-r*5.0)*saturate(1.0-age*1.4);
float mask = saturate((wave+inner+lattice)*pow(1.0-age,1.3));
return float4(Tint*max(Intensity,0.0),mask);
