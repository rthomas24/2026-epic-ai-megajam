    def Scope "MaterialX" (
        references = @./pbrgen_Green_Moss_Carpet.mtlx@</MaterialX>
    )
    {
    }

    def Scope "Materials"
    {
        def Material "PbrgenMaterial"
        {
            token outputs:surface.connect = </Root/Materials/PbrgenMaterial/Surface.outputs:surface>

            def Shader "uvReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

        def Shader "COL_tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @pbrgen_Green_Moss_Carpet_COL_2K.png@
            float2 inputs:st.connect = </Root/Materials/PbrgenMaterial/uvReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            token inputs:sourceColorSpace = "sRGB"
            float3 outputs:rgb
        }

        def Shader "ROUGH_tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @pbrgen_Green_Moss_Carpet_ROUGH_2K.png@
            float2 inputs:st.connect = </Root/Materials/PbrgenMaterial/uvReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            token inputs:sourceColorSpace = "raw"
            float outputs:r
        }

        def Shader "NRM_tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @pbrgen_Green_Moss_Carpet_NRM_2K.png@
            float2 inputs:st.connect = </Root/Materials/PbrgenMaterial/uvReader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            token inputs:sourceColorSpace = "raw"
            float4 inputs:scale = (2, 2, 2, 1)
            float4 inputs:bias = (-1, -1, -1, 0)
            float3 outputs:rgb
        }

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                int inputs:useSpecularWorkflow = 0
            color3f inputs:diffuseColor.connect = </Root/Materials/PbrgenMaterial/COL_tex.outputs:rgb>
            float inputs:roughness.connect = </Root/Materials/PbrgenMaterial/ROUGH_tex.outputs:r>
            normal3f inputs:normal.connect = </Root/Materials/PbrgenMaterial/NRM_tex.outputs:rgb>
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0
            color3f inputs:emissiveColor = (0, 0, 0)
                token outputs:surface
            }
        }

        def Material "PbrgenLogo"
        {
            token outputs:surface.connect = </Root/Materials/PbrgenLogo/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                token outputs:surface
            }
        }
    }

    def DistantLight "Key" (apiSchemas = ["ShadowAPI"])
    {
        float inputs:intensity = 3.3
        bool inputs:normalize = 1
        float inputs:angle = 1.5
        bool inputs:shadow:enable = 1
        matrix4d xformOp:transform = ( (-0.78087, 0, -0.6247, 0), (-0.21925, 0.93639, 0.27406, 0), (0.58496, 0.35097, -0.73119, 0), (0, 0, 0, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DistantLight "Fill"
    {
        float inputs:intensity = 0.75
        bool inputs:normalize = 1
        bool inputs:shadow:enable = 0
        matrix4d xformOp:transform = ( (0.8, 0, 0.6, 0), (0.3087, 0.85749, -0.4116, 0), (-0.5145, 0.5145, 0.68599, 0), (0, 0, 0, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DomeLight "Ambient"
    {
        float inputs:intensity = 0.07958
    }
}
