--- /dev/null
+++ b/Source/unrealGameJam/TriadDrift/Director/TDDirectorCardMotion.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "TriadDrift/Director/TDCutPresentation.h"
+
+/** Presentation-only line reveal from the existing real-time Director state. No second clock. */
+namespace TDDirectorCardMotion
+{
+	inline float Reveal01(const FTDDirectorCard& Card,bool bReducedMotion)
+	{
+		if(!Card.bActive) return 0.f;
+		if(bReducedMotion) return 1.f;
+		// Invalid state must not leave a permanently half-drawn decoration.
+		if(!FMath::IsFinite(Card.Progress01) || !FMath::IsFinite(Card.TimeLeft)) return 1.f;
+		const float P=FMath::Clamp(Card.Progress01,0.f,1.f);
+		if(P>=.9999f || Card.TimeLeft<=0.f) return 1.f;
+		const float Total=Card.TimeLeft/(1.f-P);
+		const float Age=P*Total;
+		const float Duration=FMath::Min(.18f,Total*.35f);
+		const float T=FMath::Clamp(Age/FMath::Max(Duration,.0001f),0.f,1.f);
+		return 1.f-FMath::Pow(1.f-T,3.f);
+	}
+}
