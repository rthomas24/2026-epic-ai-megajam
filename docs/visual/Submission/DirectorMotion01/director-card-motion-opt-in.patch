+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FTDDirectorCardMotionTiming,"TriadDrift.Director.Cards.LineRevealUsesHostTime",TD_TEST_FLAGS)
+bool FTDDirectorCardMotionTiming::RunTest(const FString&)
+{
+	for(const float Total:{.1f,1.3f,2.f})
+	{
+		FTDDirectorCard Card;
+		Card.bActive=true;Card.Text=FText::FromString(TEXT("SCENE 6 · CINDER · OUTPOST · TAKE 2"));
+		const FText Original=Card.Text;
+		float Previous=0.f;
+		for(int32 I=0;I<=100;++I)
+		{
+			Card.Progress01=I/100.f;Card.TimeLeft=Total*(1.f-Card.Progress01);
+			const float Reveal=TDDirectorCardMotion::Reveal01(Card,false);
+			TestTrue(TEXT("reveal bounded and monotonic"),Reveal>=Previous && Reveal<=1.f);
+			TestEqual(TEXT("reduced motion is immediately complete"),TDDirectorCardMotion::Reveal01(Card,true),1.f);
+			if(I>=35) TestTrue(TEXT("short cards complete before their dwell ends"),Reveal>=.999f);
+			TestTrue(TEXT("presentation never changes or hides text"),Card.Text.EqualTo(Original));
+			Previous=Reveal;
+		}
+		Card.bActive=false;
+		TestEqual(TEXT("inactive card has no effect"),TDDirectorCardMotion::Reveal01(Card,false),0.f);
+	}
+	return true;
 }
 
